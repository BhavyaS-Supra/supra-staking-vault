# Copy this to .env.local and fill in the values printed by the deploy scripts in ../contracts.

# Network (defaults to Supra EVM Devnet if unset; set chain id to 11155111 for Sepolia)
NEXT_PUBLIC_SUPRA_EVM_RPC_URL=https://rpc-multivm.supra.com
NEXT_PUBLIC_SUPRA_EVM_CHAIN_ID=222

# Deployed contract addresses - left blank on purpose, nothing here has been deployed yet.
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_STAKE_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=

# Optional: override token display symbols/decimals (defaults match StakeToken/RewardToken).
NEXT_PUBLIC_STAKE_TOKEN_SYMBOL=sSTK
NEXT_PUBLIC_REWARD_TOKEN_SYMBOL=sRWD
NEXT_PUBLIC_STAKE_TOKEN_DECIMALS=18
NEXT_PUBLIC_REWARD_TOKEN_DECIMALS=18
