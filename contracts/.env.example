# Never commit the real .env - copy this to .env and fill in your own values.

# Deployer key (funds gas on whichever network you deploy to). Must start with 0x.
PRIVATE_KEY=0x...

# Ethereum Sepolia
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Supra EVM Devnet
SUPRA_EVM_RPC_URL=https://rpc-multivm.supra.com

# Optional: initial APR in basis points for the deploy scripts (1_000 = 10%). Defaults to 1000.
INITIAL_APR_BPS=1000

# Optional: verification (Sepolia only)
ETHERSCAN_API_KEY=
